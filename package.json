{
  "name": "matu-game-1",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/netcode.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "3d-tiles-renderer": "0.5.0",
    "@types/node": "^22.13.4",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.0",
    "three": "^0.185.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
